	function WindowObject:Minimize()
		if self.IsMinimized then
			Creator.Tween(WindowContainer, 0.35, {
				Size = UDim2.new(0, self.OriginalSize.X, 0, self.OriginalSize.Y),
				Position = self.OriginalPosition,
			}, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
			self.IsMinimized = false
			MainContent.Visible = true
		else
			Creator.Tween(WindowContainer, 0.35, {
				Size = UDim2.new(0, 240, 0, 50),
				Position = UDim2.new(1, -260, 1, -70),
			}, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
			self.IsMinimized = true
			MainContent.Visible = false
		end
	end
	
	function WindowObject:SetTheme(ThemeName)
		if Themes[ThemeName] then
			WindObsidian.CurrentTheme = Themes[ThemeName]
			Creator.SetThemeTag(WindowContainer, { ImageColor3 = "Background" }, 0.25)
			Creator.SetThemeTag(TopBar, { ImageColor3 = "ElementBackground" }, 0.25)
			
			TitleLabel.TextColor3 = WindObsidian.CurrentTheme.Text
			
			for _, Tab in ipairs(self.Tabs) do
				Creator.SetThemeTag(Tab.Button, { TextColor3 = "Text" }, 0.25)
				for _, Element in ipairs(Tab.Elements) do
					if Element.Container then
						for _, Child in ipairs(Element.Container:GetDescendants()) do
							if Child:IsA("TextLabel") or Child:IsA("TextButton") then
								Creator.Tween(Child, 0.25, { TextColor3 = WindObsidian.CurrentTheme.Text }):Play()
							end
						end
					end
				end
			end
		end
	end
	
	MinimizeButton.MouseButton1Click:Connect(function()
		self:Minimize()
	end)
	
	CloseButton.MouseButton1Click:Connect(function()
		Creator.Tween(WindowContainer, 0.3, { Size = UDim2.new(0, self.OriginalSize.X, 0, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.In):Play()
		task.wait(0.3)
		ScreenGui:Destroy()
	end)
	
	local DragConnection
	TopBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local UserInputService = game:GetService("UserInputService")
			local Mouse = game:GetService("Players").LocalPlayer:GetMouse()
			local StartMousePos = Vector2.new(Mouse.X, Mouse.Y)
			local StartWindowPos = WindowContainer.AbsolutePosition
			
			if DragConnection then DragConnection:Disconnect() end
			
			DragConnection = RunService.RenderStepped:Connect(function()
				local CurrentMousePos = Vector2.new(Mouse.X, Mouse.Y)
				local Delta = CurrentMousePos - StartMousePos
				local NewPos = StartWindowPos + Delta
				
				WindowContainer.Position = UDim2.new(0, NewPos.X, 0, NewPos.Y)
			end)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and DragConnection then
			DragConnection:Disconnect()
			DragConnection = nil
		end
	end)
	
	if Config.ShowStats then
		local StatsLabel = Creator.New("TextLabel", {
			Size = UDim2.new(0, 200, 0, 60),
			Position = UDim2.new(0, 10, 1, -80),
			BackgroundColor3 = WindObsidian.CurrentTheme.ElementBackground,
			BackgroundTransparency = 0.2,
			TextColor3 = WindObsidian.CurrentTheme.Text,
			TextSize = 11,
			Font = Enum.Font.Monospace,
			Text = "WindObsidian",
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			Parent = ScreenGui,
		})
		
		Creator.New("UICorner", {
			CornerRadius = UDim.new(0, 8),
			Parent = StatsLabel,
		})
		
		Creator.New("UIStroke", {
			Color = WindObsidian.CurrentTheme.Border,
			Thickness = 1,
			Transparency = 0.5,
			Parent = StatsLabel,
		})
		
		Creator.New("UIPadding", {
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			Parent = StatsLabel,
		})
		
		local FrameCount = 0
		local LastUpdate = tick()
		
		RunService.Heartbeat:Connect(function()
			FrameCount = FrameCount + 1
			local CurrentTime = tick()
			local Delta = CurrentTime - LastUpdate
			
			if Delta >= 1 then
				local FPS = math.round(FrameCount / Delta)
				local MS = math.round(Delta * 1000 / FrameCount)
				local Stats = game:GetService("Stats")
				local Ping = math.round(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
				
				StatsLabel.Text = "WindObsidian v2.0\nFPS: " .. FPS .. "\nMS: " .. MS .. "ms\nPing: " .. Ping .. "ms"
				
				FrameCount = 0
				LastUpdate = CurrentTime
			end
		end)
	end
	
	table.insert(WindObsidian.Windows, WindowObject)
	
	return WindowObject
end

return {
	Window = Window,
	Creator = Creator,
	Themes = Themes,
	Icons = LucideIcons,
	Version = WindObsidian.Version,
}
