		Font = Enum.Font.Gotham,
		ZIndex = 51,
		Parent = pickerFrame,
	}, { Create("UICorner", { CornerRadius = UDim.new(0, 4) }) })

	local bBox = Create("TextBox", {
		Size = UDim2.new(0, 36, 0, 22),
		Position = UDim2.new(0, 168, 1, -32),
		BackgroundColor3 = Library.Theme.ElementBackground,
		Text = tostring(math.floor(default.B * 255)),
		TextColor3 = Library.Theme.Text,
		TextSize = 12,
		Font = Enum.Font.Gotham,
		ZIndex = 51,
		Parent = pickerFrame,
	}, { Create("UICorner", { CornerRadius = UDim.new(0, 4) }) })

	local function UpdateColor(nh, ns, nv, skip)
		h, s, v = nh or h, ns or s, nv or v
		local col = Color3.fromHSV(h, s, v)
		preview.ImageColor3 = col
		svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueCursor.Position = UDim2.new(0.5, 0, h, 0)
		hexBox.Text = string.format("#%02X%02X%02X", col.R * 255, col.G * 255, col.B * 255)
		rBox.Text = tostring(math.floor(col.R * 255))
		gBox.Text = tostring(math.floor(col.G * 255))
		bBox.Text = tostring(math.floor(col.B * 255))
		if not skip then
			SafeCallback(callback, col)
			if flag then Library.Flags[flag] = col end
		end
	end

	UpdateColor(h, s, v, true)

	local draggingSV, draggingHue = false, false

	Connect(svBox.InputBegan, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			draggingSV = true
		end
	end)
	Connect(hueBar.InputBegan, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			draggingHue = true
		end
	end)
	Connect(UserInputService.InputEnded, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			draggingSV = false
			draggingHue = false
		end
	end)
	Connect(UserInputService.InputChanged, function(inp)
		if inp.UserInputType \~= Enum.UserInputType.MouseMovement and inp.UserInputType \~= Enum.UserInputType.Touch then return end
		if draggingSV then
			local rel = svBox.AbsolutePosition
			local size = svBox.AbsoluteSize
			local nx = math.clamp((inp.Position.X - rel.X) / size.X, 0, 1)
			local ny = math.clamp((inp.Position.Y - rel.Y) / size.Y, 0, 1)
			UpdateColor(nil, nx, 1 - ny)
		elseif draggingHue then
			local rel = hueBar.AbsolutePosition
			local size = hueBar.AbsoluteSize
			local ny = math.clamp((inp.Position.Y - rel.Y) / size.Y, 0, 1)
			UpdateColor(ny, nil, nil)
		end
	end)

	Connect(preview.InputBegan, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			open = not open
			pickerFrame.Visible = open
		end
	end)

	local api = {}
	function api:Set(c)
		if typeof(c) == "Color3" then
			local nh, ns, nv = Color3.toHSV(c)
			UpdateColor(nh, ns, nv)
		end
	end
	function api:Get()
		return Color3.fromHSV(h, s, v)
	end
	if flag then Library.Flags[flag] = api end
	return holder, api
end

