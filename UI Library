				if listening and inp.UserInputType == Enum.UserInputType.Keyboard then
					key = inp.KeyCode
					lbl.Text = key.Name
					listening = false
					SafeCallback(callback, key)
					if flag then Library.Flags[flag] = key end
				elseif not gpe and inp.KeyCode == key and not listening then
					SafeCallback(callback, key)
				end
			end)

			local api = {}
			function api:Set(k)
				key = k
				lbl.Text = k.Name
