			Font = Enum.Font.Gotham,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 202,
			Parent = dlg,
		})

		local yesBtn = Create("TextButton", {
			Size = UDim2.new(0, 100, 0, 30),
			Position = UDim2.new(0, 20, 1, -42),
			BackgroundColor3 = Library.Theme.Success,
			Text = "Yes",
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			ZIndex = 202,
			Parent = dlg,
		}, {
			Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
		})

		local noBtn = Create("TextButton", {
			Size = UDim2.new(0, 100, 0, 30),
			Position = UDim2.new(1, -120, 1, -42),
			BackgroundColor3 = Library.Theme.Danger,
			Text = "Cancel",
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			ZIndex = 202,
			Parent = dlg,
		}, {
			Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
		})

		local function Close()
			Tween(blur, { Size = 0 }, TweenInfo.new(0.2))
			Tween(overlay, { BackgroundTransparency = 1 }, TweenInfo.new(0.2))
			task.wait(0.2)
			blur:Destroy()
			overlay:Destroy()
		end

		Connect(yesBtn.MouseButton1Click, function()
			Close()
			SafeCallback(onYes)
		end)
		Connect(noBtn.MouseButton1Click, function()
			Close()
			SafeCallback(onNo)
		end)
	end

