local Creator = {}

function Creator.New(ClassName, Properties, Children)
	local Instance = cloneref(Instance).new(ClassName)
	
	if Properties then
		for Property, Value in pairs(Properties) do
			if not pcall(function()
				Instance[Property] = Value
			end) then
				if Property == "ThemeTag" then
					Creator.SetThemeTag(Instance, Value)
				end
			end
		end
	end
	
	if Children then
		for _, Child in ipairs(Children) do
			Child.Parent = Instance
		end
	end
	
	return Instance
end

function Creator.Tween(Instance, Duration, Properties, EasingStyle, EasingDirection)
	local TweenInfo = TweenInfo.new(
		Duration,
		EasingStyle or Enum.EasingStyle.Quad,
		EasingDirection or Enum.EasingDirection.Out
	)
	local Tween = TweenService:Create(Instance, TweenInfo, Properties)
	return Tween
end

function Creator.NewRoundFrame(CornerRadius, Properties, Children)
	local Frame = Creator.New("ImageLabel", {
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(49, 49, 450, 450),
		Image = "rbxasset://textures/GradientRectangle.png",
	})
	
	if Properties then
		for Property, Value in pairs(Properties) do
			if Property ~= "ThemeTag" then
				pcall(function()
					Frame[Property] = Value
				end)
			else
				Creator.SetThemeTag(Frame, Value)
			end
		end
	end
	
	if Children then
		for _, Child in ipairs(Children) do
			Child.Parent = Frame
		end
	end
	
	Creator.New("UICorner", {
		CornerRadius = UDim.new(0, CornerRadius),
		Parent = Frame,
	})
	
	return Frame
end

function Creator.SetThemeTag(Instance, ThemeTag, Duration)
	if not WindObsidian.CurrentTheme then
		WindObsidian.CurrentTheme = Themes.Dark
	end
	
	for Tag, PropertyPath in pairs(ThemeTag) do
		local Value = WindObsidian.CurrentTheme[PropertyPath]
		if Value then
			if Duration and Duration > 0 then
				Creator.Tween(Instance, Duration, { [Tag] = Value }):Play()
			else
				Instance[Tag] = Value
			end
		end
	end
end

function Creator.SafeCallback(Callback, ...)
	if typeof(Callback) == "function" then
		task.spawn(function()
			pcall(Callback, ...)
		end)
	end
end

