						Text = "  " .. tostring(item),
						TextColor3 = Library.Theme.Text,
						TextSize = 12,
						Font = Enum.Font.Gotham,
						TextXAlignment = Enum.TextXAlignment.Left,
						Parent = dropScroll,
					}, {
						Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
					})
					Connect(b.MouseButton1Click, function()
						if multi then
							selected[item] = not selected[item]
						else
							selected = item
							open = false
							Tween(drop, { Size = UDim2.new(1, 0, 0, 0) }, TweenInfo.new(0.15))
							task.delay(0.15, function() drop.Visible = false end)
						end
						RefreshDisplay()
						SafeCallback(callback, multi and selected or selected)
						if flag then Library.Flags[flag] = multi and selected or selected end
					end)
				end
			end

			BuildList()
			RefreshDisplay()

			Connect(box.InputBegan, function(inp)
				if inp.UserInputType == Enum.UserInputType.MouseButton1 then
					open = not open
					if open then
						drop.Visible = true
						local h = math.min(#list * 28 + 4, 160)
						Tween(drop, { Size = UDim2.new(1, 0, 0, h) }, TweenInfo.new(0.2, Enum.EasingStyle.Quint))
					else
						Tween(drop, { Size = UDim2.new(1, 0, 0, 0) }, TweenInfo.new(0.15))
						task.delay(0.15, function() drop.Visible = false end)
					end
				end
			end)

			local api = {}
			function api:Set(v)
				if multi then
					selected = type(v) == "table" and v or {}
				else
					selected = v
				end
				RefreshDisplay()
			end
			function api:Get()
				return selected
			end
			if flag then Library.Flags[flag] = api end
			return api
		end

