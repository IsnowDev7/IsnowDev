					if Input.UserInputType == Enum.UserInputType.MouseButton1 then
						DestroyPicker()
					end
				end)
				
				local CurrentH = 0
				local CurrentS = 1
				local CurrentV = 1
				
				local function UpdatePreview(Color)
					PreviewFrame.ImageColor3 = Color
					HexInput.Text = "#" .. string.format("%06X", Color:ToHex())
					UpdateColor(Color)
				end
				
				SaturationValueGradient.InputBegan:Connect(function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1 then
						local function UpdateSV()
							local Mouse = game:GetService("Players").LocalPlayer:GetMouse()
							local Pos = SaturationValueGradient.AbsolutePosition
							local Size = SaturationValueGradient.AbsoluteSize
							
							CurrentS = math.clamp((Mouse.X - Pos.X) / Size.X, 0, 1)
							CurrentV = math.clamp(1 - (Mouse.Y - Pos.Y) / Size.Y, 0, 1)
							
							SVSelector.Position = UDim2.new(CurrentS, -6, CurrentV, -6)
							UpdatePreview(Color3.fromHSV(CurrentH, CurrentS, CurrentV))
						end
						
						local SV_Conn
						SV_Conn = UserInputService.InputChanged:Connect(function()
							UpdateSV()
						end)
						
						UserInputService.InputEnded:Connect(function(Input2)
							if Input2.UserInputType == Enum.UserInputType.MouseButton1 then
								SV_Conn:Disconnect()
							end
						end)
						
						UpdateSV()
					end
				end)
				
				HueBar.InputBegan:Connect(function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1 then
						local function UpdateHue()
							local Mouse = game:GetService("Players").LocalPlayer:GetMouse()
							local Pos = HueBar.AbsolutePosition
							local Size = HueBar.AbsoluteSize
							
							CurrentH = math.clamp((Mouse.X - Pos.X) / Size.X, 0, 1)
							HueSelector.Position = UDim2.new(CurrentH, 0, 0, 0)
							
							SaturationValueGradient.BackgroundColor3 = Color3.fromHSV(CurrentH, 1, 1)
							UpdatePreview(Color3.fromHSV(CurrentH, CurrentS, CurrentV))
						end
						
						local Hue_Conn
						Hue_Conn = UserInputService.InputChanged:Connect(function()
							UpdateHue()
						end)
						
						UserInputService.InputEnded:Connect(function(Input2)
							if Input2.UserInputType == Enum.UserInputType.MouseButton1 then
								Hue_Conn:Disconnect()
							end
						end)
						
						UpdateHue()
					end
				end)
				
				HexInput.FocusLost:Connect(function()
					local HexValue = HexInput.Text:gsub("#", "")
					if string.len(HexValue) == 6 then
						local R = tonumber(HexValue:sub(1, 2), 16) / 255
						local G = tonumber(HexValue:sub(3, 4), 16) / 255
						local B = tonumber(HexValue:sub(5, 6), 16) / 255
						local NewColor = Color3.new(R, G, B)
						UpdatePreview(NewColor)
					end
				end)
			end)
			
