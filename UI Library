				Size = UDim2.new(0.55, 0, 1, 0),
				BackgroundTransparency = 1,
				TextColor3 = WindObsidian.CurrentTheme.Text,
				TextSize = 13,
				Font = Enum.Font.Gotham,
				Text = KeybindName,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				Parent = KeybindContainer,
			})
			
			local KeyButton = Creator.NewRoundFrame(8, {
				Size = UDim2.new(0.40, 0, 1, 0),
				Position = UDim2.new(0.55, 0, 0, 0),
				BackgroundTransparency = 0.75,
				ThemeTag = { ImageColor3 = "ElementBackground" },
				Parent = KeybindContainer,
			})
			
			Creator.New("UIStroke", {
				Color = WindObsidian.CurrentTheme.Border,
				Thickness = 1,
				Transparency = 0.5,
				Parent = KeyButton,
			})
			
			local KeyLabel = Creator.New("TextLabel", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				TextColor3 = WindObsidian.CurrentTheme.Primary,
				TextSize = 12,
				Font = Enum.Font.GothamBold,
				Text = tostring(DefaultKey):match("Enum%.KeyCode%.(.+)") or tostring(DefaultKey),
				TextXAlignment = Enum.TextXAlignment.Center,
				Parent = KeyButton,
			})
			
			local CurrentKey = DefaultKey
			local IsListening = false
			
			local HitBox = Creator.New("TextButton", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				Text = "",
				Parent = KeyButton,
			})
			
			HitBox.MouseButton1Click:Connect(function()
				IsListening = true
				KeyLabel.Text = "Press key..."
				Creator.Tween(KeyButton, 0.1, { ImageTransparency = 0.5 }):Play()
				
				local Connection
				Connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
					if not gameProcessed and IsListening then
						if input.UserInputType == Enum.UserInputType.Keyboard then
							CurrentKey = input.KeyCode
							KeyLabel.Text = tostring(CurrentKey):match("Enum%.KeyCode%.(.+)") or tostring(CurrentKey)
							IsListening = false
							Creator.Tween(KeyButton, 0.1, { ImageTransparency = 0.75 }):Play()
							Connection:Disconnect()
							Creator.SafeCallback(Callback, CurrentKey)
						end
					end
				end)
				
				task.wait(5)
				if IsListening then
					IsListening = false
					KeyLabel.Text = tostring(CurrentKey):match("Enum%.KeyCode%.(.+)") or tostring(CurrentKey)
					Creator.Tween(KeyButton, 0.1, { ImageTransparency = 0.75 }):Play()
					Connection:Disconnect()
				end
			end)
			
			HitBox.MouseEnter:Connect(function()
				Creator.Tween(KeyButton, 0.12, { ImageTransparency = 0.6 }):Play()
			end)
			
			HitBox.MouseLeave:Connect(function()
				Creator.Tween(KeyButton, 0.12, { ImageTransparency = 0.75 }):Play()
			end)
			
			UserInputService.InputBegan:Connect(function(input, gameProcessed)
				if not gameProcessed and input.KeyCode == CurrentKey then
					Creator.SafeCallback(Callback, CurrentKey)
				end
			end)
			
			table.insert(TabObj.Elements, {
				Container = KeybindContainer,
				Type = "Keybind",
				Key = CurrentKey,
				Set = function(_, Key)
					CurrentKey = Key
					KeyLabel.Text = tostring(Key):match("Enum%.KeyCode%.(.+)") or tostring(Key)
				end,
			})
			
			return KeybindContainer
		end
		
