			local valLbl = Create("TextLabel", {
				Size = UDim2.new(0, 48, 0, 16),
				Position = UDim2.new(1, -4, 0, 0),
				AnchorPoint = Vector2.new(1, 0),
				BackgroundTransparency = 1,
				Text = tostring(val) .. suf,
				TextColor3 = Library.Theme.TextDim,
				TextSize = 11,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})

			local track = Create("Frame", {
				Size = UDim2.new(1, -8, 0, 5),
				Position = UDim2.new(0, 4, 0, 28),
				BackgroundColor3 = Library.Theme.Element,
				Parent = row,
			})
			Corner(track, 3)

			local fill = Create("Frame", {
				Size = UDim2.new(0, 0, 1, 0),
				BackgroundColor3 = Library.Theme.Accent,
				Parent = track,
			})
			Corner(fill, 3)

			local knob = Create("Frame", {
				Size = UDim2.new(0, 14, 0, 14),
				Position = UDim2.new(0, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = Color3.new(1, 1, 1),
				Parent = track,
			})
			Corner(knob, 99)

			local api = { Value = val }

			local function Set(v, cb)
				v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
				val = v
				api.Value = v
				local p = (v - min) / (max - min)
				Tween(fill, { Size = UDim2.new(p, 0, 1, 0) }, TweenInfo.new(0.1))
				Tween(knob, { Position = UDim2.new(p, 0, 0.5, 0) }, TweenInfo.new(0.1))
				valLbl.Text = tostring(v) .. suf
				if cb \~= false then Safe(opts.Callback, v) end
				if opts.Flag then Library.Flags[opts.Flag] = v end
			end

			function api:Set(v) Set(v, true) end
			Set(val, false)

			local slide = false
			Connect(track.InputBegan, function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					slide = true
					local p = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
					Set(min + p * (max - min))
				end
			end)
			Connect(UserInputService.InputEnded, function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					slide = false
				end
			end)
			Connect(UserInputService.InputChanged, function(i)
				if slide and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
					local p = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
					Set(min + p * (max - min))
				end
			end)

			if opts.Flag then Library.Flags[opts.Flag] = api end
			return api
		end

