		blur.Parent = Lighting
		Tween(blur, { Size = 12 }, TweenInfo.new(0.25))

		local overlay = Create("Frame", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			ZIndex = 200,
