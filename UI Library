			})
			
			local SliderHandle = Creator.NewRoundFrame(10, {
				Size = UDim2.new(0, 18, 0, 18),
				Position = UDim2.new(0, 0, 0.5, -9),
				BackgroundTransparency = 0.1,
				ThemeTag = { ImageColor3 = "Primary" },
				Parent = SliderTrack,
			})
			
			Creator.New("UIStroke", {
				Color = Color3.new(1, 1, 1),
				Thickness = 2,
				Transparency = 0.3,
				Parent = SliderHandle,
			})
			
			Creator.New("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
					ColorSequenceKeypoint.new(1, WindObsidian.CurrentTheme.Primary),
				}),
				Parent = SliderHandle,
			})
			
			local CurrentValue = DefaultValue
			
			local function UpdateSlider(MouseX)
				local TrackSize = SliderTrack.AbsoluteSize.X
				local TrackPosition = SliderTrack.AbsolutePosition.X
				local Percentage = math.clamp((MouseX - TrackPosition) / TrackSize, 0, 1)
				CurrentValue = math.round(Min + (Max - Min) * Percentage)
				
				local Offset = Percentage * TrackSize
				Creator.Tween(SliderHandle, 0.08, { Position = UDim2.new(0, Offset - 9, 0.5, -9) }):Play()
				Creator.Tween(SliderFill, 0.08, { Size = UDim2.new(Percentage, 0, 1, 0) }):Play()
				
				Label.Text = SliderName .. ": " .. tostring(CurrentValue)
				Creator.SafeCallback(Callback, CurrentValue)
			end
			
			local HitBox = Creator.New("TextButton", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				Text = "",
				Parent = SliderTrack,
			})
			
			HitBox.MouseButton1Down:Connect(function()
				local Connection
				Connection = UserInputService.InputChanged:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseMovement then
						UpdateSlider(input.Position.X)
					end
				end)
				
				local EndConnection
				EndConnection = UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						Connection:Disconnect()
						EndConnection:Disconnect()
					end
				end)
			end)
			
			UpdateSlider(SliderTrack.AbsolutePosition.X + (((DefaultValue - Min) / (Max - Min)) * SliderTrack.AbsoluteSize.X))
			
			table.insert(TabObj.Elements, {
				Container = SliderContainer,
				Type = "Slider",
				Value = CurrentValue,
				Set = function(_, Value)
					UpdateSlider(SliderTrack.AbsolutePosition.X + (((Value - Min) / (Max - Min)) * SliderTrack.AbsoluteSize.X))
				end,
			})
			
			return SliderContainer
		end
		
