function Library:Notify(opts)
	opts = opts or {}
	local title = opts.Title or "Notification"
	local content = opts.Content or ""
	local duration = opts.Duration or 3.5
	local color = opts.Color or Library.Theme.Accent

	local holder = EnsureHolder()
	local n = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = Library.Theme.Background,
		ClipsDescendants = true,
		Parent = holder,
	})
	Corner(n, 10)
	Stroke(n, nil, 1, 0.6)

	Create("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = n,
	})

	Create("TextLabel", {
		Size = UDim2.new(1, -18, 0, 18),
		Position = UDim2.new(0, 12, 0, 8),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = Library.Theme.Text,
		TextSize = 13,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = n,
	})

	local body = Create("TextLabel", {
		Size = UDim2.new(1, -18, 0, 0),
		Position = UDim2.new(0, 12, 0, 28),
		BackgroundTransparency = 1,
		Text = content,
		TextColor3 = Library.Theme.TextDim,
		TextSize = 12,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Parent = n,
	})

	local h = math.clamp(TextService:GetTextSize(content, 12, Enum.Font.Gotham, Vector2.new(270, 800)).Y + 44, 52, 140)
	body.Size = UDim2.new(1, -18, 0, h - 40)
	n.Size = UDim2.new(1, 0, 0, h)
	n.Position = UDim2.new(1, 30, 0, 0)

	Tween(n, { Position = UDim2.new(0, 0, 0, 0) })
	task.delay(duration, function()
		if n and n.Parent then
			Tween(n, { Position = UDim2.new(1, 40, 0, 0), BackgroundTransparency = 1 }, TweenInfo.new(0.28))
			task.wait(0.3)
			n:Destroy()
		end
	end)
end

-- Config
function Library:SaveConfig(name)
	name = name or "default"
	local data = {}
	for k, v in pairs(Library.Flags) do
		if typeof(v) == "Color3" then
			data[k] = { v.R, v.G, v.B }
		elseif type(v) == "table" and v.Get then
			local val = v:Get()
			if typeof(val) == "Color3" then
				data[k] = { val.R, val.G, val.B }
			else
				data[k] = val
			end
		else
			data[k] = v
		end
	end
	if writefile then
		writefile("UI_" .. name .. ".json", HttpService:JSONEncode(data))
	end
end

function Library:LoadConfig(name)
	name = name or "default"
	if not (readfile and isfile) then return end
	local path = "UI_" .. name .. ".json"
	if not isfile(path) then return end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) \~= "table" then return end
	for k, v in pairs(data) do
		local obj = Library.Flags[k]
		if obj and type(obj) == "table" and obj.Set then
			if type(v) == "table" and #v == 3 then
				obj:Set(Color3.new(v[1], v[2], v[3]))
			else
				obj:Set(v)
			end
		end
	end
end

-- Glass helper
local Glass = {
	Id = "rbxassetid://77297718671545",
	Mirrored = "rbxassetid://92258969882244",
	Size = Vector2.new(102, 128),
	Total = 80,
	Cols = 10,
}

local function GlassFrame(t)
	local f
	if t <= 0.4 then
		f = math.floor((t / 0.4) * (Glass.Total - 1))
	elseif t < 0.6 then
		f = Glass.Total - 1
	else
		f = math.floor(((t - 0.6) / 0.4) * (Glass.Total - 1))
	end
	f = math.clamp(f, 0, Glass.Total - 1)
	local mir = t >= 0.6
	if mir then f = (Glass.Total - 1) - f end
	local id = mir and Glass.Mirrored or Glass.Id
	return id, Glass.Size, Vector2.new((f % Glass.Cols) * Glass.Size.X, math.floor(f / Glass.Cols) * Glass.Size.Y)
end

