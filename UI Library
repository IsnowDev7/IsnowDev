				BackgroundColor3 = Library.Theme.Element,
				Parent = page,
			})
			Corner(b, 8)
			local v = Create("VideoFrame", {
				Size = UDim2.new(1, -6, 1, -6),
				Position = UDim2.new(0, 3, 0, 3),
				Video = opts.VideoId or "rbxassetid://5608310205",
				Looped = true,
				Playing = true,
				Parent = b,
			})
			Corner(v, 6)
			return v
		end

		function tab:AddCustom(class, props)
			props = props or {}
			props.Parent = page
			return Create(class, props)
		end

		return tab
	end

	function Window:Dialog(opts)
		opts = opts or {}
		local blur = Instance.new("BlurEffect")
		blur.Size = 0
		blur.Parent = Lighting
		Tween(blur, { Size = 14 }, TweenInfo.new(0.22))

		local ov = Create("Frame", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			ZIndex = 200,
			Parent = gui,
		})
		Tween(ov, { BackgroundTransparency = 0.5 }, TweenInfo.new(0.22))

		local d = Create("Frame", {
			Size = UDim2.new(0, 290, 0, 130),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Library.Theme.Background,
			ZIndex = 201,
			Parent = ov,
		})
		Corner(d, 11)
		Stroke(d)

		Create("TextLabel", {
			Size = UDim2.new(1, -16, 0, 22),
			Position = UDim2.new(0, 12, 0, 10),
			BackgroundTransparency = 1,
			Text = opts.Title or "Confirm",
			TextColor3 = Library.Theme.Text,
			TextSize = 14,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 202,
			Parent = d,
		})
		Create("TextLabel", {
			Size = UDim2.new(1, -16, 0, 36),
			Position = UDim2.new(0, 12, 0, 36),
			BackgroundTransparency = 1,
			Text = opts.Content or "Are you sure?",
			TextColor3 = Library.Theme.TextDim,
			TextSize = 12,
			Font = Enum.Font.Gotham,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 202,
			Parent = d,
		})

		local yes = Create("TextButton", {
			Size = UDim2.new(0, 95, 0, 28),
			Position = UDim2.new(0, 18, 1, -38),
			BackgroundColor3 = Library.Theme.Success,
			Text = "Yes",
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 12,
			Font = Enum.Font.GothamMedium,
			ZIndex = 202,
			Parent = d,
		})
		Corner(yes, 6)

		local no = Create("TextButton", {
			Size = UDim2.new(0, 95, 0, 28),
			Position = UDim2.new(1, -113, 1, -38),
			BackgroundColor3 = Library.Theme.Danger,
			Text = "Cancel",
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 12,
			Font = Enum.Font.GothamMedium,
			ZIndex = 202,
			Parent = d,
		})
		Corner(no, 6)

		local function Close()
			Tween(blur, { Size = 0 }, TweenInfo.new(0.18))
			Tween(ov, { BackgroundTransparency = 1 }, TweenInfo.new(0.18))
			task.wait(0.2)
			blur:Destroy()
			ov:Destroy()
		end
		Connect(yes.MouseButton1Click, function() Close() Safe(opts.OnYes) end)
		Connect(no.MouseButton1Click, function() Close() Safe(opts.OnNo) end)
	end

	table.insert(Library.Windows, Window)
	return Window
end

return Library
